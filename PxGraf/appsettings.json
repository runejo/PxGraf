{
  "LogOptions": {
    "Folder": "Logs", // Fill path to the log directory
    "SysId": "PxGraf",
    "AuthMethod": "Anonymous",
    "Level": "Debug"
  },
  "CacheOptions": {
    // Sliding expiration is counted from the latest cache read
    "Meta": {
      "SlidingExpirationMinutes": "2",
      "AbsoluteExpirationMinutes": "15"
    },
    "Data": {
      "SlidingExpirationMinutes": "30",
      "AbsoluteExpirationMinutes": "120"
    },
    "Database": {
      "AbsoluteExpirationMinutes": "5",
      "SlidingExpirationMinutes": "2",
      "ItemAmountLimit": "1000" // responses
    },
    "Table": {
      "SlidingExpirationMinutes": "5"
    },
    "Visualization": {
      "SlidingExpirationMinutes": "15",
      "AbsoluteExpirationMinutes": "720", // 12 hours
      "ItemAmountLimit": "1000" // responses
    },
    "CacheFreshnessCheckIntervalSeconds": "45"
  },
  "Cors": {
    "AllowAnyOrigin": true,
    "AllowedOrigins": ["*"]
  },
  "QueryOptions": {
    "MaxHeaderLength": 180,
    "MaxQuerySize": 100000
  },
  "Language": {
    "Default": "no",
    "Available": ["no", "en"]
  },
  // CHANGE THESE FOR LOCAL TESTING
  "pxwebUrl": "https://data.qa.ssb.no/", // This is used when pxgraf builds pxweb urls for some spesific px table to be returned in api responses.
  "savedQueryDirectory": "SavedQueries", // Fill path to query files
  "archiveFileDirectory": "ArchivedQueries", // Fill path to archive files
  "FeatureManagement": {
    "CreationAPI": true // Enables/disables the creation controller.
  },
  "LocalFileSystemDatabaseConfig": {
    // Configuration for the local database.
    "Enabled": false, // Set to false to disable using the local database and use the PxWeb API instead.
    "DatabaseRootPath": "", // Fill path to the database root directory
    "Encoding": "latin1", // Encoding of the database files
    "DatabaseWhitelist": ["table"] // List of database names to list in the editor
  }
}
